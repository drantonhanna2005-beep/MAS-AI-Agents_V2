# Runtime provider credentials (keep this file private; never commit .env)
# Real AI chat requires either a running Ollama model or one configured provider key.
# Get keys from the provider's official console. Placeholder values are ignored.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# auto | ollama | groq | openrouter | gemini | offline
MAS_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
MAS_OLLAMA_MODEL=llama3.1:8b
MAS_GROQ_MODEL=openai/gpt-oss-20b
MAS_OPENROUTER_MODEL=openrouter/free
MAS_GEMINI_MODEL=gemini-2.0-flash
